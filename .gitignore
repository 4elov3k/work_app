# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.cache/
/backend/.gocache/

# next.js
/.next/
/out/

# Regenerated by `next dev`/`next build` on every checkout (see the file's
# own comment) — tracking it caused a pull conflict on any machine that had
# already run next dev before this file existed in git, so it's local-only.
/AGENTS.md
/CLAUDE.md

# production
/build
/export/
/import/

# misc
.DS_Store
*.pem

# secrets / credentials (root-level OAuth client files etc.)
client_secret*.json
*credentials*.json
*.credentials.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local settings
.claude/settings.local.json
