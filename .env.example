DATABASE_URL=postgres://invoices_user:invoices_password@postgres:5432/invoices_db?sslmode=disable

# REST backend
PORT=8080
CORS_ORIGIN=http://localhost:3000
DADATA_API_KEY=
REDMINE_URL=
REDMINE_API=

# Background "control event due soon" notifications via Hermes (unset = scheduler no-ops)
REDMINE_NOTIFY_URL=
REDMINE_NOTIFY_TOKEN=
REDMINE_NOTIFY_DAYS_BEFORE=3

# Document parsing (delegates OCR/text extraction to the Hermes ocr-extract service)
OCR_SERVICE_URL=http://hermes_ocr_extract:8643
OCR_SERVICE_TOKEN=

# Act-number sync with the Google Sheets registry (via Hermes sheets-sync)
SHEETS_SYNC_URL=http://hermes_sheets_sync:8644
SHEETS_SYNC_TOKEN=

# Звонари: OnlinePBX call data
PBX_DOMAIN=
PBX_API_TOKEN=

# Call transcription (Hermes, faster-whisper — local, no LLM)
TRANSCRIBE_SERVICE_URL=http://hermes_call_transcribe:8645
TRANSCRIBE_SERVICE_TOKEN=
# Optional: an on-LAN GPU box running the same transcribe_server.py with
# TRANSCRIBE_DEVICE=cuda, e.g. http://192.168.1.50:8645 — tried first when
# set, falls back to TRANSCRIBE_SERVICE_URL on any failure (including "off").
TRANSCRIBE_SERVICE_GPU_URL=
TRANSCRIBE_SERVICE_GPU_TOKEN=

# Per-call classification + caller period reports (Hermes, ChatGPT over transcript text)
CALL_ANALYTICS_URL=http://hermes_call_analytics:8646
CALL_ANALYTICS_TOKEN=

# Saby EDO participant lookup for UPD XML
SABY_BASE_URL=https://online.sbis.ru
SABY_ACCESS_TOKEN=
SABY_SESSION_ID=
SABY_LOGIN=
SABY_PASSWORD=
SABY_ACCOUNT_NUMBER=
SABY_TIMEOUT=10s
SABY_SELLER_EDO_ID=
SABY_SELLER_INN=526220116209
SABY_SELLER_KPP=
SABY_SELLER_NAME=Индивидуальный предприниматель Мыленкова Любовь Валерьевна

# Accounting MCP
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=3000
MCP_PATH=/mcp
MCP_AUTH_ENABLED=true
MCP_AUTH_TOKEN=
DOCUMENT_STORAGE_PATH=/data/documents
ORGANIZATION_TIMEZONE=Europe/Moscow
CONFIRMATION_TOKEN_TTL=15m
COUNTERPARTY_LOOKUP_PROVIDER=none
EDI_PROVIDER=none
ALLOW_DOCUMENT_FINALIZATION=true
ALLOW_DOCUMENT_SENDING=false
ALLOW_COUNTERPARTY_DELETION=false
